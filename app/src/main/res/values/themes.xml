<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SalahMate" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
      Launcher splash. Uses the androidx core-splashscreen attributes so the icon, background and
      hand-off to Theme.SalahMate are consistent on API 24 through 36.
    -->
    <style name="Theme.SalahMate.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/salahmate_emerald</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.SalahMate</item>
    </style>
</resources>
